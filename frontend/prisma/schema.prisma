// SlyPay B-lite: Supabase Auth + Prisma sur Postgres (même schéma métier, sans JWT maison)
// User.id = auth.users.id (UUID)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SpendCategory {
  GROCERIES
  DINING
  TRAVEL
  GAS
  ONLINE_SHOPPING
  DRUGSTORES
  ENTERTAINMENT
  WHOLESALE
  OTHER
}

enum EarningType {
  CASHBACK_PERCENT
  POINTS
  MILES
}

enum OfferStackPolicy {
  REPLACE_BASE
  ADDITIVE
}

enum MappingSource {
  MCC
  MANUAL
  USER_REPORTED
}

enum UserRole {
  USER
  ADMIN
}

enum CardIntelJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED_NO_SOURCE
}

enum CardCatalogExtractProposalStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// Canonical issuer-document-derived rewards snapshot keyed by catalog slug (matches autocomplete ids).
model CardCatalogProduct {
  slug                  String    @id
  name                  String
  issuer                String
  colorHex              String?
  imageUrl              String?
  /// Curated URL of the official card rewards/terms PDF (or trusted issuer-hosted PDF).
  officialDocumentUrl   String?
  lastExtractHash       String?
  lastExtractJson       Json?
  lastFetchedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  proposals   CardCatalogExtractProposal[]
  intelJobs   CardIntelJob[]
  creditCards CreditCard[]

  @@index([issuer])
}

/// Émetteurs appris après un PDF officiel réussi (domaine + libellé affichage).
model KnownIssuer {
  /// Clé stable du site (ex. registrable host `biltrewards.com`).
  apexDomain  String   @id
  displayName String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([displayName])
}

model CardCatalogExtractProposal {
  id              String                           @id @default(cuid())
  productSlug     String
  product         CardCatalogProduct               @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  previousHash    String?
  proposedHash    String
  proposedPayload Json
  status          CardCatalogExtractProposalStatus @default(PENDING)
  createdAt       DateTime                         @default(now())

  @@index([productSlug, status])
  @@index([createdAt])
}

model CardIntelJob {
  id            String             @id @default(cuid())
  productSlug   String
  product       CardCatalogProduct @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  creditCardId  String?
  creditCard    CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  status        CardIntelJobStatus @default(PENDING)
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())

  @@index([productSlug, createdAt])
  @@index([creditCardId])
}

model User {
  id        String   @id
  email     String   @unique
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditCards             CreditCard[]
  transactions            Transaction[]
  recommendations         Recommendation[]
  recommendationFeedbacks RecommendationFeedback[]

  @@index([email])
  @@index([role])
}

model CreditCard {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  issuer             String
  last4              String?
  colorHex           String?             @default("#0f172a")
  isActive           Boolean             @default(true)
  catalogProductSlug String?
  catalogProduct     CardCatalogProduct? @relation(fields: [catalogProductSlug], references: [slug], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  rewardRules RewardRule[]
  offers      Offer[]
  intelJobs   CardIntelJob[]

  @@index([userId, isActive])
  @@index([catalogProductSlug])
}

model RewardRule {
  id               String        @id @default(cuid())
  creditCardId     String
  creditCard       CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category         SpendCategory
  multiplier       Decimal       @db.Decimal(6, 3)
  earningType      EarningType   @default(POINTS)
  capAmountMonthly Decimal?      @db.Decimal(12, 2)
  priority         Int           @default(0)
  notes            String?
  createdAt        DateTime      @default(now())

  @@index([creditCardId, category])
}

model Offer {
  id           String           @id @default(cuid())
  creditCardId String
  creditCard   CreditCard       @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  title        String
  category     SpendCategory?
  multiplier   Decimal          @db.Decimal(6, 3)
  stackPolicy  OfferStackPolicy @default(REPLACE_BASE)
  validFrom    DateTime
  validUntil   DateTime
  createdAt    DateTime         @default(now())

  @@index([creditCardId])
  @@index([validFrom, validUntil])
}

model Merchant {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  normalized  String
  mcc         String?  @db.VarChar(4)
  notes       String?
  createdAt   DateTime @default(now())

  categoryMappings MerchantCategoryMapping[]
  transactions     Transaction[]

  @@index([normalized])
  @@index([mcc])
}

model MerchantCategoryMapping {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category   SpendCategory
  source     MappingSource @default(MANUAL)
  confidence Decimal       @default(1.0) @db.Decimal(4, 3)

  @@unique([merchantId, category])
  @@index([merchantId])
}

model MccCategoryMap {
  mcc      String        @id @db.VarChar(4)
  category SpendCategory
  label    String?
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  category   SpendCategory?
  mcc        String?  @db.VarChar(4)
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

/// User-reported mismatch vs engine output (review / quality loop).
model RecommendationFeedback {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation     Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  kind               String
  note               String?
  context            Json?
  createdAt          DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([recommendationId])
}

model Recommendation {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  resolvedCategory SpendCategory
  merchantName     String?
  mcc              String?       @db.VarChar(4)
  bestCardId       String?
  explanation      Json
  alternates       Json?
  createdAt        DateTime      @default(now())

  feedbacks RecommendationFeedback[]

  @@index([userId, createdAt])
}
