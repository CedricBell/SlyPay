{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "NEXT_WEBPACK_DISABLE_FS_CACHE=1 next dev",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "dev:webpack:clean": "rm -rf .next && NEXT_WEBPACK_DISABLE_FS_CACHE=1 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "db:diff": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --script",
    "db:reset-intel": "prisma db execute --file prisma/reset-card-pipeline-data.sql --schema prisma/schema.prisma && npx tsx scripts/sync-catalog.ts",
    "db:reset-cards": "prisma db execute --file prisma/reset-card-pipeline-full.sql --schema prisma/schema.prisma && npx tsx scripts/sync-catalog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^5.22.0",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "15.5.14",
    "next-themes": "^0.4.6",
    "openai": "^6.37.0",
    "pdf-parse": "1.1.1",
    "prisma": "^5.22.0",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
