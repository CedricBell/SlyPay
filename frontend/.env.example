# SpendLess (Next.js App Router + Supabase Auth + Prisma)
# Copy to .env.local:  cp .env.example .env.local
# Never commit .env.local or real API keys.

# -----------------------------------------------------------------------------
# Supabase Auth (Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Auth redirects (Supabase → Authentication → URL Configuration):
# Site URL: http://localhost:3000 (or your production domain)
# Redirect URLs: http://localhost:3000/auth/callback, http://localhost:3000/reset-password

# Public app origin (absolute URLs for admin-uploaded catalog PDFs)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Supabase → Project Settings → Database → Connection string URI)
# Local/dev: Direct or Session mode is usually fine.
# On Vercel: prefer Transaction mode (pooler) — see Supabase + Prisma docs.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional: first authenticated request with this email gets Prisma role ADMIN (lowercase).
# SEED_ADMIN_EMAIL=you@example.com

# Only if you still call an external Nest API (default B-lite: same origin — leave unset).
# NEXT_PUBLIC_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Card intelligence (official PDF → JSON extract → reward rules / admin proposals)
# -----------------------------------------------------------------------------
# Required for extract-on-add and admin “apply” mapping:
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# CARD_INTEL_PROVIDER=openai,anthropic
# CARD_INTEL_MODEL=gpt-4o-mini
# CARD_INTEL_MAX_DOC_CHARS=120000

# Dev overrides (force a PDF for one catalog slug without changing DB):
# CARD_INTEL_OVERRIDE_SLUG=amex-platinum
# CARD_INTEL_OVERRIDE_PDF_URL=https://example.com/your-test.pdf

# PDF discovery (issuer site crawl / search). Defaults avoid open-web search.
# INTEL_ALLOW_ISSUER_SITE_SEARCH=1
# INTEL_ALLOW_OPEN_WEB=1
# BRAVE_SEARCH_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# PDF_DISCOVERY_PROVIDER=google_cse

# Optional: Google Places (server) for nearby merchants
# GOOGLE_PLACES_API_KEY=your_google_places_api_key

# -----------------------------------------------------------------------------
# Maps (client — Google Maps JavaScript API)
# Restrict this key by HTTP referrer in Google Cloud Console.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Prisma migrations (from frontend/)
#   npx prisma migrate deploy
#   npx prisma migrate dev
#   npx prisma generate
# -----------------------------------------------------------------------------
