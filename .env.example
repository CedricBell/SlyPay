# Copy values into backend/.env and/or frontend/.env.local for local development.
# Never commit real secrets. Rotate any key that was ever committed by mistake.

# --- Optional NestJS API (backend/) ---
DATABASE_URL=postgresql://spendless:spendless@localhost:5432/spendless
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=14
PORT=4000
CORS_ORIGIN=http://localhost:3000
# First matching login email can be promoted to ADMIN (see session-user / seed).
# SEED_ADMIN_EMAIL=you@example.com

# --- Frontend pointing at Nest API (optional; B-lite uses same-origin /api/v1) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional: Google Places API (New) for nearby merchants (server-side).
# GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Card intel pipeline (PDF → LLM → rules / admin proposals). Set at least one:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# CARD_INTEL_PROVIDER=openai,anthropic
# CARD_INTEL_MODEL=gpt-4o-mini
# CARD_INTEL_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
