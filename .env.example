# Copy to backend/.env and frontend/.env.local for local development

# --- Backend (NestJS) ---
DATABASE_URL=postgresql://spendless:spendless@localhost:5432/spendless
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=14
PORT=4000
CORS_ORIGIN=http://localhost:3000
# First Supabase login with this email gets Prisma role ADMIN (see frontend/src/lib/session-user.ts).
# SEED_ADMIN_EMAIL=you@example.com

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Same as above: used when creating the Prisma User on first login (Next server).
# SEED_ADMIN_EMAIL=you@example.com
# Optional: Google Places API (New) key for nearby POI — enables broader merchant discovery next to OpenStreetMap.
GOOGLE_PLACES_API_KEY=AIzaSyADp7kmadMSAgsAy7jm7l52SaAkFmKYqfw

# Card intel pipeline (PDF → LLM → rules / admin proposals). Set at least one:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-api03-...
# If both are set, OpenAI is tried first and Anthropic is used on 429/quota. Override order with:
# CARD_INTEL_PROVIDER=anthropic
# CARD_INTEL_PROVIDER=openai,anthropic
# CARD_INTEL_MODEL=gpt-4o-mini
# CARD_INTEL_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
