# Copy to backend/.env and frontend/.env.local for local development

# --- Backend (NestJS) ---
DATABASE_URL=postgresql://spendless:spendless@localhost:5432/spendless
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=14
PORT=4000
CORS_ORIGIN=http://localhost:3000
# SEED_ADMIN_EMAIL=you@example.com

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: Google Places API (New) key for nearby POI — enables broader merchant discovery next to OpenStreetMap.
# GOOGLE_PLACES_API_KEY=
