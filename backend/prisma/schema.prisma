// SpendLess — rewards intelligence schema
// Indexing: FK lookups, time-range offers, user-scoped lists, merchant search

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SpendCategory {
  GROCERIES
  DINING
  TRAVEL
  GAS
  ONLINE_SHOPPING
  DRUGSTORES
  ENTERTAINMENT
  WHOLESALE
  OTHER
}

enum EarningType {
  CASHBACK_PERCENT
  POINTS
  MILES
}

enum OfferStackPolicy {
  REPLACE_BASE
  ADDITIVE
}

enum MappingSource {
  MCC
  MANUAL
  USER_REPORTED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  creditCards     CreditCard[]
  transactions    Transaction[]
  recommendations Recommendation[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CreditCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  issuer    String
  last4     String?
  colorHex  String?  @default("#0f172a")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardRules RewardRule[]
  offers      Offer[]

  @@index([userId, isActive])
}

model RewardRule {
  id               String        @id @default(cuid())
  creditCardId     String
  creditCard       CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category         SpendCategory
  multiplier       Decimal       @db.Decimal(6, 3)
  earningType      EarningType   @default(POINTS)
  capAmountMonthly Decimal?      @db.Decimal(12, 2)
  priority         Int           @default(0)
  notes            String?

  createdAt DateTime @default(now())

  @@index([creditCardId, category])
}

model Offer {
  id           String           @id @default(cuid())
  creditCardId String
  creditCard   CreditCard       @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  title        String
  category     SpendCategory?
  multiplier   Decimal          @db.Decimal(6, 3)
  stackPolicy  OfferStackPolicy @default(REPLACE_BASE)
  validFrom    DateTime
  validUntil   DateTime
  createdAt    DateTime         @default(now())

  @@index([creditCardId])
  @@index([validFrom, validUntil])
}

model Merchant {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  normalized  String
  mcc         String?  @db.VarChar(4)
  notes       String?
  createdAt   DateTime @default(now())

  categoryMappings MerchantCategoryMapping[]
  transactions     Transaction[]

  @@index([normalized])
  @@index([mcc])
}

model MerchantCategoryMapping {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category   SpendCategory
  source     MappingSource @default(MANUAL)
  confidence Decimal       @default(1.0) @db.Decimal(4, 3)

  @@unique([merchantId, category])
  @@index([merchantId])
}

/// Default category when only MCC is known (ISO 18245-style 4-digit codes)
model MccCategoryMap {
  mcc      String        @id @db.VarChar(4)
  category SpendCategory
  label    String?
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  category   SpendCategory?
  mcc        String?  @db.VarChar(4)
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Recommendation {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  resolvedCategory SpendCategory
  merchantName     String?
  mcc              String?       @db.VarChar(4)
  bestCardId       String?
  explanation      Json
  alternates       Json?
  createdAt        DateTime      @default(now())

  @@index([userId, createdAt])
}
